---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Portfolio Hub">
    <h2>Portfolio Hub</h2>
        <p>Danny Huynh</p>
        <br/>

        <section>
            <h3>Software Projects</h3>
            <p>Projects that are mainly based on programming and coding.</p>
            <a href="/software-project">View software projects</a>
        </section>

        <section>
            <h3>Hardware Projects</h3>
            <p>Projects that are mainly done physically.</p>
            <a href="/hardware-project">View hardware projects</a>
        </section>

        <section>
            <h3>Key Projects</h3>
            <project-collection>
                <article>
                    <h4>MATX PC Build</h4>
                    <img src="/images/First_custom_pc_setup.PNG" alt="Picture featuring my first setup with my first custom pc, including a monitor, keyboard, and mouse, 
                the pc is mainly blakc with a glass side panel to see the insides where you can mainly see the motherboard, gpu and cpu fan." width="200">
                    <p>
                        My first PC build, learnt the basics of the computer architecture
                        and computer components
                    </p>
                    <button commandfor="matx-pc-build-key-project" command="show-modal">More details</button>
                </article>
            </project-collection>
        </section>

        <!-- Implement feature to show dialog when hovering over project -->
        <dialog id="matx-pc-build-key-project">
            <h4>MATX PC Build</h4>
            <p>
                Description: I gathered the main concepts and key steps to build a functional
                computer through surface level research from known creators from <a href="https://www.youtube.com" target="_blank">
                YouTube</a>. Then with resources/sites (such as
                <a href="https://pcpartpicker.com" target="_blank">pcpartpicker</a>)
                recommended by these creators, I planned out the components to get that are budget friendly
                while also being powerful enough to run basic games at a good frame rates (~120-200 fps).
                The build runs on AMD's AM4 platform, using an AMD Ryzen 5 5500 processor for the CPU,
                32 GB DDR4 ram (3200 MT/s), 1 TB SSD storage, and has the AMD Raedeon RX 6600 as the GPU.
            </p>
            <button commandfor="matx-pc-build-key-project" command="close">close</button>
        </dialog>

        <section>
            <h3>Recent GitHub Activity</h3>
            <github-activity username="danh-506" count="5">
                <p>
                    Unable to load recent activity right now —
                    <a href="https://github.com/danh-506" target="_blank">view my GitHub profile directly</a>.
                </p>
            </github-activity>
        </section>

        <noscript>
            <p>This site functions without JavaScript enabled, besides the recent github activity section.</p>
        </noscript>

</BaseLayout>