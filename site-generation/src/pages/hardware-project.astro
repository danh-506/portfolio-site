---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const hardwareProjects = allProjects.filter(
  (project) => project.data.category === 'hardware'
);
---

<BaseLayout title="Hardware Projects">
  <h2>Hardware Projects</h2>

  {hardwareProjects.map((project) => (
    <article>
      <h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3>
      {project.data.image && (
        <img src={project.data.image} alt="" width="400" />
      )}
      <p>{project.data.description}</p>
    </article>
  ))}
</BaseLayout>