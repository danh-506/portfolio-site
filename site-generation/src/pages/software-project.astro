---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const softwareProjects = allProjects.filter(
  (project) => project.data.category === 'software'
);
---

<BaseLayout title="Software Projects">
  <h2>Software Projects</h2>

  {softwareProjects.map((project) => (
    <article>
      <h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3>
      {project.data.image && (
        <img src={project.data.image} alt="" width="400" />
      )}
      <p>{project.data.description}</p>
    </article>
  ))}
</BaseLayout>